BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Val white-label (baked into production UI at Docker build time)
NEXT_PUBLIC_PRODUCT_NAME=Val
NEXT_PUBLIC_PRODUCT_FULL_NAME="Val by hyprtask"
NEXT_PUBLIC_PRODUCT_TAGLINE="Voice agents for AR Caller"
NEXT_PUBLIC_BRAND_DOMAIN=hyprtask.ai
NEXT_PUBLIC_HIDE_UPSTREAM_CHROME=true
# OSS local auth cookie names (legacy dograh_auth_* still accepted on read)
OSS_TOKEN_COOKIE=val_auth_token
OSS_USER_COOKIE=val_auth_user
# NEXT_PUBLIC_DOCS_URL=
# NEXT_PUBLIC_PRIVACY_URL=https://hyprtask.ai/privacy
# NEXT_PUBLIC_TERMS_URL=https://hyprtask.ai/terms
# Port the dev server binds. Leave unset for Next's default (3000, auto-
# incrementing if busy). scripts/worktree-sync-env.sh sets this per git worktree
# and points the backend's CORS_ALLOWED_ORIGINS + UI_APP_URL at it.
# UI_PORT=3000
# Base URL of the user-facing app, used for superadmin impersonation redirects
# (defaults to the current origin when unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_NODE_ENV=development
# form submissions backend
# NEXT_PUBLIC_ONBOARDING_API_URL=http://localhost:8001
# Google Tag Manager container ID (e.g. GTM-XXXXXXX); GTM is not loaded when blank
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook) Pixel ID; the Pixel is not loaded when blank (OSS/dev)
NEXT_PUBLIC_META_PIXEL_ID=
# Dograh Cloud only - shows the current event banner; not loaded when blank
NEXT_PUBLIC_EVENT_BANNER=
